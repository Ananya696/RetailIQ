# Database (same value as database/.env)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/retailiq?schema=public"

# Auth: generate with `openssl rand -hex 32`. The server will not start without it.
JWT_SECRET="replace_with_a_long_random_secret"

# URLs
PORT=5000
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8001
GENAI_SERVICE_URL=http://localhost:8000

# Shared secret sent to the Python services (same value in ml-service and genai-service)
INTERNAL_KEY=change_me

# Use the shop's time zone so "today" on the dashboard is correct
TZ=Asia/Kolkata

# Optional
# NODE_ENV=production
# AUTH_RATE_LIMIT=20          # login/signup/set-password attempts per 15 min per IP
# SEED_ADMIN_EMAIL=admin@retailiq.demo
# SEED_PASSWORD=Demo@12345
# SEED_CSV=../ml-service/data/train.csv
