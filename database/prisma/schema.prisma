// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String?
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])

  invitedById  Int?
  invitedBy    User?    @relation("StaffInvites", fields: [invitedById], references: [id])
  invitedStaff User[]   @relation("StaffInvites")

  isActive     Boolean  @default(false)
  inviteToken  String?  @unique

  inviteExpiresAt DateTime?
  employeeCode    String?    @unique
  aiReports       AIReport[] @relation("ReportAuthor")

  sales        Sale[]
  createdAt    DateTime @default(now())
}

model Product {
  id             Int          @id @default(autoincrement())
  name           String
  category       String?
  price          Decimal      @db.Decimal(10, 2)
  cost           Decimal?     @db.Decimal(10, 2)       // cost price — store ne kitne mein khareeda
  supplier       String?
  isArchived     Boolean      @default(false)
  isPerishable   Boolean      @default(false)
  shelfLifeDays  Int?
  stock          Stock?
  sales          Sale[]
  predictions    Prediction[]
  createdAt      DateTime     @default(now())
}

model Stock {
  id                Int       @id @default(autoincrement())
  productId         Int       @unique
  product           Product   @relation(fields: [productId], references: [id])
  quantity          Int       @default(0)
  lowStockThreshold Int       @default(10)
  expiryDate        DateTime? // Sirf perishable products ke liye
  updatedAt         DateTime  @updatedAt
}

model Sale {
  id            Int           @id @default(autoincrement())
  productId     Int
  product       Product       @relation(fields: [productId], references: [id])
  soldById      Int
  soldBy        User          @relation(fields: [soldById], references: [id])
  quantitySold  Int
  salePrice     Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  anomalyScore  Float?
  anomalyReason String?
  isAnomaly     Boolean       @default(false)
  saleDate      DateTime      @default(now())

  @@index([productId, saleDate])
  @@index([soldById, saleDate])
}

model Prediction {
  id             Int      @id @default(autoincrement())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  storeId        Int?
  predictedSales Int
  predictionDate DateTime
  forDate        DateTime
  createdAt      DateTime @default(now())

  @@index([productId, forDate])
}

model AIReport {
  id              Int      @id @default(autoincrement())
  title           String
  content         String
  generatedBy     Int
  generatedByUser User     @relation("ReportAuthor", fields: [generatedBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([generatedBy])
}